# ---------------------------------------------------------------------------
# Backend B (upstream SSE) — host/port or full base URL
# ---------------------------------------------------------------------------
# Preferred: full base URL
# BACKEND_B_BASE_URL=http://192.168.1.111:8001

# Or compose from host + port (used when BACKEND_B_BASE_URL is empty)
BACKEND_B_HOST=192.168.1.111
BACKEND_B_PORT=8001

# Stream path on Backend B (query: query / session_id / function)
BACKEND_B_STREAM_PATH=/api/chat/stream

# Optional shared secret for Backend B
# BACKEND_B_API_KEY=

# ---------------------------------------------------------------------------
# Session logs WebSocket (upstream, usually same host as Backend B)
# Frontend connects with ?session_id=<current session>
# ---------------------------------------------------------------------------
# Preferred: full WS base URL (no query string)
# LOGS_WS_URL=ws://localhost:8001/ws/logs

# Or compose when LOGS_WS_URL is empty (defaults fall back to BACKEND_B_*)
# LOGS_WS_HOST=localhost
# LOGS_WS_PORT=8001
# LOGS_WS_PATH=/ws/logs

# ---------------------------------------------------------------------------
# Field projection for related_entries (comma-separated keys)
# Only listed fields are forwarded to the frontend for rendering.
# Leave empty to use built-in defaults.
# ---------------------------------------------------------------------------
# Example: only show first two achievement fields
# ACHIEVEMENT_DISPLAY_FIELDS=serial_no,achievement_name

# Full achievement catalog keys (pick any subset, order preserved):
# serial_no,achievement_name,achievement_contributors,research_team_leader_type,
# primary_technology_field,secondary_technology_field,nanjing_key_industry_field,
# commercialization_method,maturity_level,achievement_ownership,rights_ownership_type,
# individual_name,individual_id_number,rights_holding_organization_name,
# intended_amount_10k_cny,achievement_brief,achievement_overview,
# publishing_organization_name,contact_name,contact_phone,related_expert_team,
# is_carbon_peaking_neutrality_related,review_time
ACHIEVEMENT_DISPLAY_FIELDS=serial_no,achievement_name,achievement_contributors,primary_technology_field,maturity_level,achievement_brief,publishing_organization_name,contact_name

# Optional other scenes (when Backend B supports them)
# EXPERT_DISPLAY_FIELDS=serial_no,expert_name,organization,research_field
# DEMAND_DISPLAY_FIELDS=serial_no,demand_name,industry,brief
# ENTERPRISE_DISPLAY_FIELDS=serial_no,enterprise_name,industry,brief
# PLATFORM_DISPLAY_FIELDS=serial_no,platform_name,organization,brief
# POLICY_DISPLAY_FIELDS=serial_no,policy_name,level,brief

# ---------------------------------------------------------------------------
# Optional legacy LLM (not used by the Backend B proxy path)
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://101.226.11.38:25000/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
